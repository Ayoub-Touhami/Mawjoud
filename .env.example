# Copier ce fichier en .env et remplacer les valeurs fictives. .env n'est jamais commité.

# Scripts de la base (migrations, import, base de test) : compte propriétaire, jamais utilisé par le back-end.
DATABASE_URL=postgresql://utilisateur:motdepasse@127.0.0.1:5432/mawjoud

# Back-end : compte mawjoud_api (migration 025). Ne pas écrire à la main :
# .\database\definir-mot-de-passe-api.ps1 génère le mot de passe et écrit cette ligne.
API_DATABASE_URL=postgresql://mawjoud_api:motdepasse-genere@127.0.0.1:5432/mawjoud

# Réglages du back-end (facultatifs ; valeurs par défaut du développement ci-dessous).
# NODE_ENV=development
# API_PORT=3000
# FRONT_URL=http://localhost:4200
# CORS_ORIGINES=http://localhost:4200
# EMAIL_FOURNISSEUR=console
# TRUST_PROXY=false

# Premier administrateur : à définir seulement le temps de lancer « npm run admin:creer »
# dans la session PowerShell, jamais dans ce fichier (voir docs/API_COMPTES.md).
# ADMIN_EMAIL=
# ADMIN_MOT_DE_PASSE=
